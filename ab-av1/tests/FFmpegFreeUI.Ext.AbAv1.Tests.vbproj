<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionStrict>On</OptionStrict>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- 依赖版本由 PackageReference 和锁文件固定。 -->
    <NuGetAudit>false</NuGetAudit>
    <RootNamespace>FFmpegFreeUI.Ext.AbAv1.Tests</RootNamespace>
    <AssemblyName>FFmpegFreeUI.Ext.AbAv1.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="FakeAbAv1\**\*.vb" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FFmpegFreeUI.Ext.AbAv1.vbproj" />
    <ProjectReference Include="FakeAbAv1\FakeAbAv1.vbproj" ReferenceOutputAssembly="false" />
    <!-- 测试会直接实例化 SDK 合同类型，因此保留测试运行时资产。 -->
    <PackageReference Include="FFmpegFreeUI.Ext.PluginSdk" Version="[2.5.0]" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyFakeAbAv1" AfterTargets="Build">
    <ItemGroup>
      <_FakeAbAv1File Include="$(MSBuildProjectDirectory)\FakeAbAv1\bin\$(Configuration)\net10.0\ab-av1.exe" />
      <_FakeAbAv1File Include="$(MSBuildProjectDirectory)\FakeAbAv1\bin\$(Configuration)\net10.0\ab-av1.dll" />
      <_FakeAbAv1File Include="$(MSBuildProjectDirectory)\FakeAbAv1\bin\$(Configuration)\net10.0\ab-av1.deps.json" />
      <_FakeAbAv1File Include="$(MSBuildProjectDirectory)\FakeAbAv1\bin\$(Configuration)\net10.0\ab-av1.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_FakeAbAv1File)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
